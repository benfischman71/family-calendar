rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{document=**} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.familyId;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.familyId;
    }
  }
}
